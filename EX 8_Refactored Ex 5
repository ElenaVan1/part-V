ONBOARDINGSCREEN_BY_NAME_TPL = "//*[@resource-id='org.wikipedia:id/scrollViewContainer']//*[@text='{TEXT}']",

   //
    public void waitForScreenToAppearByName(String text)
    {
        String xpath = ONBOARDINGSCREEN_BY_NAME_TPL.replace("{TEXT}", text);
        this.waitForElementPresent(
                By.xpath(xpath),
                "Onboarding screen has no title" + ONBOARDINGSCREEN_BY_NAME_TPL,
                15
        );
    }
    //
    public void waitForScreenToAppearById(String screen_id)
    {
        this.waitForElementPresent(By.id(screen_id), "Cannot find screen by id " + screen_id, 15);
    }
